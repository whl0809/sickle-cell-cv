# ============================================================
# DaoLab / sickle-cell pipeline -- repo-level ignore rules
#
# Policy: track code, notebooks, and small result artifacts
# (CSV reports + summary plots). Exclude raw video, image
# datasets, model weights, and the multi-hundred-MB
# per-run intermediates.
#
# The excluded weights and datasets are listed in the README
# under "Data not in this repository".
# ============================================================

# ---------- OS / editor cruft ----------
# WSL/Windows writes an alternate-data-stream sidecar next to every downloaded file;
# on Linux these surface as real files. 11k of them were removed during the 2026 cleanup.
*Zone.Identifier
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vscode/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
venv/
env/
ENV/
.env
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Model weights / checkpoints ----------
# All of models/ is excluded: ~4.3 GB, far past GitHub's 100 MB/file limit.
/models/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
*.hdf5

# Training run scratch
runs/
wandb/
lightning_logs/
checkpoint-*/

# ---------- Redistributable bundles ----------
# Zipped model+script packs handed to collaborators. Regenerated on demand, and every
# member is already present under models/ and code/.
/dist/
*.zip

# ---------- Raw input data ----------
# Source video and the cropped single-cell PNG datasets.
/data/
*.mp4
*.avi
*.mov
*.mkv
*.m4v
*.wmv
*.tif
*.tiff

# ---------- Large per-run pipeline intermediates ----------
# ~140 MB each: full per-cell tracking dict for a whole video
cell_info.pkl
# ~36 MB each: full-resolution first frame of the video
first_frame.png
# ~6 MB each: Cellpose segmentation mask array
masks_remove_edge_cells.npy
*.npy
*.npz

# ---------- Explicitly keep small result artifacts ----------
!*.csv
!state_ratio_plot.png
!state_ratio_plot_binary.png
!frame0_class_pie.png
!combined_state_ratio_plot.png
!combined_frame0_class_pie.png
!masks_BEFORE_remove_edge_cells.png
!masks_AFTER_remove_edge_cells.png
!df.pkl
